# Copied to /opt/tom8to/.env on the VM (mode 600). Never commit a real copy.

# Managed by deploy.sh on each deploy — leave as-is.
TAG=latest

# us-central1-docker.pkg.dev/<project-id>/tom8to
REGISTRY=us-central1-docker.pkg.dev/project-b34fa6f3-390d-413d-8fb/tom8to

DOMAIN=tomato.alex-ware.com

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app_db

# Gmail SMTP for verification codes / password resets (see email_service.py)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

FRONTEND_URL=https://tomato.alex-ware.com
